{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRIDEX policy-document v1.1 (v1.0 compatible)",
  "type": "object",
  "required": [
    "title",
    "organization",
    "published_date",
    "category",
    "subcategory",
    "plan_family",
    "plan_number",
    "document_stage",
    "topics",
    "source_url",
    "attachment_url",
    "related_documents",
    "previous_document",
    "next_document",
    "collected_date",
    "file_hash",
    "verification_status",
    "schema_version",
    "id",
    "source_id",
    "ai_generated",
    "summary_review_status",
    "draft",
    "attachments",
    "events"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "category": {
      "enum": [
        "전력수급계획",
        "전력수요",
        "송변전망",
        "기술기준",
        "성능평가",
        "에너지정책",
        "재생에너지정책",
        "전력시장"
      ]
    },
    "subcategory": {
      "type": "string",
      "minLength": 1
    },
    "plan_family": {
      "enum": [
        "전력수급기본계획",
        "장기송변전설비계획",
        null,
        "에너지기본계획",
        "신재생에너지기본계획",
        "재생에너지기본계획",
        "integrated-system-plan",
        "national-transmission-needs-study",
        "national-transmission-planning-study",
        "tyndp",
        "cn-energy-system-plan"
      ]
    },
    "plan_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "document_stage": {
      "enum": [
        "announced",
        "working_draft",
        "draft",
        "consultation",
        "final",
        "amended",
        "press_release",
        "supporting",
        "official_explainer"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "attachment_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "type": "null"
        }
      ]
    },
    "related_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[a-z0-9][a-z0-9-]*\\]\\]$"
      }
    },
    "previous_document": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\[\\[[a-z0-9][a-z0-9-]*\\]\\]$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_document": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\[\\[[a-z0-9][a-z0-9-]*\\]\\]$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_date": {
      "type": "string",
      "format": "date"
    },
    "file_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "source_verified",
        "needs_review",
        "human_verified"
      ]
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "ai_generated": {
      "type": "boolean"
    },
    "summary_review_status": {
      "enum": [
        "unreviewed",
        "reviewed"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "draft": {
      "type": "boolean"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "path",
          "file_hash",
          "format",
          "size_bytes"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "path": {
            "type": "string",
            "pattern": "^data/raw/"
          },
          "file_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "format": {
            "enum": [
              "pdf",
              "hwp",
              "hwpx"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "path",
        "file_hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/raw/"
        },
        "file_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "label",
          "status",
          "source_url"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "publication",
              "scheduled",
              "confirmed"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "last_verified_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "verification_notes": {
      "type": "string",
      "minLength": 1
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "standard_id",
        "revision",
        "revised_date",
        "effective_date",
        "applicability",
        "coverage"
      ],
      "properties": {
        "document_type": {
          "enum": [
            "technical_standard",
            "test_procedure",
            "technical_notice",
            "rule_draft"
          ]
        },
        "standard_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "revised_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typed_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "type",
          "source_url",
          "basis"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^\\[\\[[a-z0-9][a-z0-9-]*\\]\\]$"
          },
          "type": {
            "enum": [
              "amends",
              "implements",
              "explains",
              "uses_evidence",
              "references"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "region_group": {
      "enum": [
        "KR",
        "AU",
        "US",
        "CN",
        "Europe"
      ]
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KR",
          "AU",
          "AU-WA",
          "US",
          "US-CA",
          "US-TX",
          "CN",
          "EU",
          "PAN-EUROPE",
          "GB",
          "DE",
          "FR"
        ]
      }
    },
    "market_regions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NEM",
          "WEM",
          "CAISO",
          "PJM",
          "ERCOT"
        ]
      }
    },
    "document_language": {
      "enum": [
        "ko",
        "en",
        "zh-Hans",
        "de",
        "fr"
      ]
    },
    "document_type": {
      "enum": [
        "plan",
        "forecast",
        "transmission_plan",
        "technical_standard",
        "test_procedure",
        "technical_notice",
        "rule_draft",
        "regulation",
        "guide",
        "study",
        "notice",
        "press_release",
        "official_explainer"
      ]
    },
    "title_original": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "title_ko": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "document_identifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "edition_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2200
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/$defs/koreanPlanRules"
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "region_group"
                  ]
                },
                {
                  "required": [
                    "jurisdictions"
                  ]
                },
                {
                  "required": [
                    "market_regions"
                  ]
                },
                {
                  "required": [
                    "document_language"
                  ]
                },
                {
                  "required": [
                    "document_type"
                  ]
                },
                {
                  "required": [
                    "title_original"
                  ]
                },
                {
                  "required": [
                    "title_ko"
                  ]
                },
                {
                  "required": [
                    "document_identifier"
                  ]
                },
                {
                  "required": [
                    "edition_year"
                  ]
                },
                {
                  "required": [
                    "version"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "region_group",
          "jurisdictions",
          "market_regions",
          "document_language",
          "document_type",
          "title_original",
          "title_ko",
          "document_identifier",
          "edition_year",
          "version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "$ref": "#/$defs/koreanPlanRules"
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "items": {
              "enum": [
                "KR"
              ]
            }
          },
          "market_regions": {
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "AU"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "items": {
              "enum": [
                "AU",
                "AU-WA"
              ]
            }
          },
          "market_regions": {
            "items": {
              "enum": [
                "NEM",
                "WEM"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "US"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "items": {
              "enum": [
                "US",
                "US-CA",
                "US-TX"
              ]
            }
          },
          "market_regions": {
            "items": {
              "enum": [
                "CAISO",
                "PJM",
                "ERCOT"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "CN"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "items": {
              "enum": [
                "CN"
              ]
            }
          },
          "market_regions": {
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "region_group": {
            "const": "Europe"
          }
        },
        "required": [
          "region_group"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "items": {
              "enum": [
                "EU",
                "PAN-EUROPE",
                "GB",
                "DE",
                "FR"
              ]
            }
          },
          "market_regions": {
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market_regions": {
            "contains": {
              "const": "NEM"
            }
          }
        },
        "required": [
          "market_regions"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "contains": {
              "const": "AU"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market_regions": {
            "contains": {
              "const": "WEM"
            }
          }
        },
        "required": [
          "market_regions"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "contains": {
              "const": "AU-WA"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market_regions": {
            "contains": {
              "const": "CAISO"
            }
          }
        },
        "required": [
          "market_regions"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "contains": {
              "const": "US"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market_regions": {
            "contains": {
              "const": "PJM"
            }
          }
        },
        "required": [
          "market_regions"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "contains": {
              "const": "US"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "market_regions": {
            "contains": {
              "const": "ERCOT"
            }
          }
        },
        "required": [
          "market_regions"
        ]
      },
      "then": {
        "properties": {
          "jurisdictions": {
            "contains": {
              "const": "US"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_family": {
            "const": "integrated-system-plan"
          }
        },
        "required": [
          "plan_family"
        ]
      },
      "then": {
        "required": [
          "region_group"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "region_group": {
            "const": "AU"
          },
          "category": {
            "enum": [
              "전력수급계획",
              "전력수요",
              "송변전망"
            ]
          },
          "plan_number": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_family": {
            "const": "national-transmission-needs-study"
          }
        },
        "required": [
          "plan_family"
        ]
      },
      "then": {
        "required": [
          "region_group"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "region_group": {
            "const": "US"
          },
          "category": {
            "enum": [
              "송변전망"
            ]
          },
          "plan_number": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_family": {
            "const": "national-transmission-planning-study"
          }
        },
        "required": [
          "plan_family"
        ]
      },
      "then": {
        "required": [
          "region_group"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "region_group": {
            "const": "US"
          },
          "category": {
            "enum": [
              "송변전망"
            ]
          },
          "plan_number": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_family": {
            "const": "tyndp"
          }
        },
        "required": [
          "plan_family"
        ]
      },
      "then": {
        "required": [
          "region_group"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "region_group": {
            "const": "Europe"
          },
          "category": {
            "enum": [
              "송변전망",
              "전력수요"
            ]
          },
          "plan_number": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_family": {
            "const": "cn-energy-system-plan"
          }
        },
        "required": [
          "plan_family"
        ]
      },
      "then": {
        "required": [
          "region_group"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "region_group": {
            "const": "CN"
          },
          "category": {
            "enum": [
              "에너지정책"
            ]
          },
          "plan_number": {
            "enum": [
              14,
              15,
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "plan_family": {
            "const": "전력수급기본계획"
          }
        },
        "required": [
          "schema_version",
          "plan_family"
        ]
      },
      "then": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "plan_family": {
            "const": "장기송변전설비계획"
          }
        },
        "required": [
          "schema_version",
          "plan_family"
        ]
      },
      "then": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "plan_family": {
            "const": "에너지기본계획"
          }
        },
        "required": [
          "schema_version",
          "plan_family"
        ]
      },
      "then": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "plan_family": {
            "const": "신재생에너지기본계획"
          }
        },
        "required": [
          "schema_version",
          "plan_family"
        ]
      },
      "then": {
        "properties": {
          "region_group": {
            "const": "KR"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "plan_family": {
